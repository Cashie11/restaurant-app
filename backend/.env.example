# Database (local development)
DATABASE_URL=sqlite:///./data/urbangrille.db

# Security
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
FRONTEND_URL=http://localhost:3000

# Email (console/simulation mode by default; leave placeholders)
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your_user
SMTP_PASSWORD=your_password

# Seed users (created by `python -m app.scripts.seed_users`)
SEED_ADMIN_EMAIL=admin@demo.com
SEED_ADMIN_PASSWORD=Admin@123
SEED_USER_EMAIL=user@example.com
SEED_USER_PASSWORD=User@1234

# Payments (test mode)
PAYSTACK_SECRET_KEY=sk_test_key
