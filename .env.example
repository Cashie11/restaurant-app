# Database Configuration
# Production: PostgreSQL (recommended — use your 24deploy managed DB URL)
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# Local development: SQLite (file-based, no extra service needed)
DATABASE_URL=postgresql://user:password@localhost:5432/urbangrille

# Security
SECRET_KEY=change-this-to-a-long-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

WATCHPACK_POLLING=true

# CORS (Fixed to allow your real domain)
FRONTEND_URL=http://localhost:3000

# Email Configuration (Still in Sandbox Mode)
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your_user
SMTP_PASSWORD=your_password

# Payments (Test Mode)
PAYSTACK_SECRET_KEY=sk_test_key
# Public key is safe to expose and is used by the frontend Paystack widget
REACT_APP_PAYSTACK_PUBLIC_KEY=pk_test_key

# Frontend Build Variable
REACT_APP_API_URL=http://localhost:8000/api

SEED_ADMIN_EMAIL=admin@demo.com
SEED_ADMIN_PASSWORD=Admin@123
SEED_USER_EMAIL=user@example.com
SEED_USER_PASSWORD=User@1234